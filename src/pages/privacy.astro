---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

const title = "Privacy | 777 Painting & Decorating";
const description =
  "How 777 Painting & Decorating uses the name, phone, email and message you send when you ask for a painting quote in Bedford.";
---

<Base
  title={title}
  description={description}
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Privacy", path: "/privacy" },
  ]}
>
  <article class="wrap page-hero prose">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Privacy</span>
    </nav>
    <h1>Privacy</h1>
    <p>
      This page says what happens to the details you send {site.name}. We are at {site.street}, {site.locality} {site.postcode}. Email {site.email}. Phone {site.phoneDisplay}.
    </p>
    <h2>What we collect</h2>
    <p>
      If you use the quote form, we receive your name, email, phone number, the service you pick, a subject and your message. If you call or email, we receive whatever you choose to tell us.
    </p>
    <h2>Why we use it</h2>
    <p>
      We use those details to reply, arrange a look at the job, and send a price. We do not sell the list. We do not use it for unrelated marketing.
    </p>
    <h2>Who else sees it</h2>
    <p>
      The form is delivered by FormSubmit, which emails the message to us. Their processing is needed to pass the form on. After that, the message sits in our email.
    </p>
    <h2>How long we keep it</h2>
    <p>
      We keep quote messages for as long as we need them to do the job and handle any follow-up. Then we delete them. You can ask us to delete your message sooner by emailing {site.email}.
    </p>
    <h2>Cookies</h2>
    <p>
      This site does not set tracking cookies. The map on the contact page is loaded from Google when you open that page.
    </p>
  </article>
</Base>
